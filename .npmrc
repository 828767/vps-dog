# pnpm settings for the whole workspace.
#
# Kept at the repository root (not only in web/ and worker/) so that the
# behaviour is identical no matter which directory a command runs from — in
# particular for Cloudflare's build environment, which runs from the root.

# Hoisted node_modules: Node's ESM resolver needs real directories rather than
# pnpm's default junction-based layout for Vite's dependency graph
# (rollup / esbuild / lightningcss) to resolve.
node-linker=hoisted

# Skip `pnpm run`'s pre-flight dependency check. When it decides a rebuild is
# needed it deletes node_modules, and on a non-TTY shell (CI, or Cloudflare's
# build runner) pnpm aborts that removal with
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY, which would fail the build.
# Build-script approval lives in pnpm-workspace.yaml (`allowBuilds`).
verify-deps-before-run=false
