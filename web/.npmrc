# Use the hoisted linker rather than pnpm's default isolated (symlinked) layout.
#
# Vite's dependency graph — rollup, esbuild, lightningcss — is resolved by Node's
# ESM resolver, and a hoisted node_modules of real directories is the layout that
# resolves identically across Node versions and platforms. It also matches what
# `npm`/`yarn` produce, which keeps the repo approachable for contributors who are
# not pnpm users. The trade-off is a slightly larger node_modules.
node-linker=hoisted

# `pnpm run <script>` first re-checks whether node_modules matches the lockfile.
# When it decides a rebuild is needed it deletes the directory, and on a non-TTY
# shell (CI, or any scripted invocation) pnpm aborts that removal with
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY, which would fail `pnpm build`.
# The install is already correct by then, so skip the pre-run check.
verify-deps-before-run=false
