# Hoisted node_modules — see web/.npmrc for the rationale (Node's ESM resolver
# needs real directories, not pnpm's default junction-based layout, and a hoisted
# tree keeps the install portable across Node versions and platforms).
node-linker=hoisted

# Skip `pnpm run`'s pre-flight dependency check. When it decides a rebuild is
# needed it deletes node_modules, and on a non-TTY shell (CI, or any scripted
# invocation) pnpm aborts that removal with
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY, which would otherwise block
# `pnpm test` / `pnpm typecheck`. Build-script approval is configured once in the
# root pnpm-workspace.yaml (`allowBuilds`).
verify-deps-before-run=false
